#######  Count of subsets sum with a given Sum ###    [MEDIUM]

import java.util.*;

public class Main {
   
   public static int countSubset(int []arr, int sum){
     int n = arr.length;
     int t[][] = new int[n+1][sum+1];
     
     for(int i = 0; i<= n; i++){
       t[i][0] = 1; 
       // becoz empty subset when  some array was given 
       //but sum = 0 then this case comes out 
     }
     
     for(int i = 1; i<= n ; i++){
       for(int j = 0; j<= sum;j++){
         if(arr[i-1] <= j){
           t[i][j] = t[i-1][j] + t[i-1][j-arr[i-1]]; 
           // this subset  or elemnet include or [(||)-- > (+)] exclude in the subset 
           
         }else{
           t[i][j] = t[i-1][j];
         }
       }
     }
     return t[n][sum]; // return last element  so total no no of subset
   }
   
   
    public static void main(String[] args) {
      
      System.out.println("Hello, Aryaman!");
      int []arr = {2, 3, 5, 8, 10};
      
      int res = countSubset(arr, 10);
      System.out.println("Total no of subset : " + res);
    }
}

TC : O(N*SUM)
SC : O(N*SUM)


