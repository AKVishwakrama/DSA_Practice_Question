##### special pos in a binary matrix
Given an m x n binary matrix mat, return the number of special positions in mat.
A position (i, j) is called special if mat[i][j] == 1 and all other elements in row i and column j are 0 (rows and columns are 0-indexed).

1.) Brute force sol

class Solution {
    public int numSpecial(int[][] mat) {
        int m = mat.length;
        int n = mat[0].length;
        int cnt = 0;
        
        for(int i = 0; i< m ; i++ ){
            for(int j = 0; j < n; j++){
                if(mat[i][j] == 1){
                    boolean isSpecial = true;

                    // check row
                    for(int col= 0; col < n; col++){
                        if(col != j && mat[i][col] == 1){
                            isSpecial = false;
                            break;
                        }
                    }

                    // check column
                    for(int row = 0; row < m; row++){
                        if(row != i && mat[row][j] == 1 ){
                            isSpecial = false;
                            break;
                        }
                    }
                    if(isSpecial) cnt ++;
                }

            }
        }
        return cnt;
    }
}

 time comp : O (M*N (M+N))
 space comp : O(1)


 

2.) Optimal sol

class Solution {
    public int numSpecial(int[][] mat) {
        int m = mat.length, n = mat[0].length;
        int[] row = new int[m];
        int[] col = new int[n];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 1) {
                    row[i]++;
                    col[j]++;
                }
            }
        }

        int ans = 0;
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (mat[i][j] == 1 && row[i] == 1 && col[j] == 1) {
                    ans++;
                }
            }
        }

        return ans;
    }
}
timer comp : O(m*n)
space comp : O(m+n)

